# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_ or VITE_.
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINANCIAL_MODELING_PREP=
# Set false to disable Yahoo's public chart endpoint (an unofficial, best-effort fallback).
MARKET_DATA_ENABLE_YAHOO_FALLBACK=true
# Optional adapters that need their own server-side credentials or service.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
AUTH_SECRET=replace-with-a-long-random-secret

# Optional runtime controls.
MARKET_DATA_CACHE_SECONDS=30
